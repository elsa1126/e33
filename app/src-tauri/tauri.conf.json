{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E33 Save Editor",
  "mainBinaryName": "e33-save-editor",
  "version": "0.1.0",
  "identifier": "io.github.elsa1126.e33",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "E33 存檔編輯",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Utility",
    "copyright": "GPL-3.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
